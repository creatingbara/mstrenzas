{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ms-trenzas-demo",
  "main": "cloudflare-entry.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "mystrenzas.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.mystrenzas.com",
      "custom_domain": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "fdad3d9e2baf4dd49dbc72759a86ac3f"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
